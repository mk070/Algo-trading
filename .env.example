# ==============================================================================
# SWING TRADING INTELLIGENCE PLATFORM - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and provide your credentials.
# NEVER commit the actual .env file or API secrets to version control.

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
# Single-user security token. Change in production.
# Required: No (defaults to demo-token-change-in-prod in development)
APP_TOKEN=demo-token-change-in-prod

# Environment mode: development | production
# Required: No (default: development)
ENV=development

# Neon PostgreSQL Connection URL
# Where to obtain: Create a free serverless PostgreSQL database at https://neon.tech/
# Required: Yes. Neon PostgreSQL is the exclusive database platform.
# Connection string format: postgresql://[user]:[password]@[endpoint-id].us-east-2.aws.neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 2. ANGEL ONE SMARTAPI (CORE INDIAN MARKET DATA)
# ------------------------------------------------------------------------------
# Where to obtain: Register at https://smartapi.angelone.in/
# Purpose: Historical daily candles, 15-minute intraday bars, live quotes, WebSocket feed.
# Required: For live Indian market data (app falls back to yfinance research mode if not provided)
ANGELONE_API_KEY=your_angelone_smartapi_key
ANGELONE_CLIENT_CODE=your_angelone_client_code
ANGELONE_PIN=your_angelone_trading_pin
# TOTP Secret Key from your authenticator app (Google Authenticator / Aegis)
# Used to programmatically generate 6-digit TOTP on daily authentication.
ANGELONE_TOTP_SECRET=your_base32_totp_secret_key

# ------------------------------------------------------------------------------
# 3. ZERODHA KITE CONNECT "PERSONAL" (READ-ONLY PORTFOLIO DATA)
# ------------------------------------------------------------------------------
# Where to obtain: Register at https://developers.kite.trade/ (Personal Free Tier)
# Purpose: Read-only portfolio sync: holdings, positions, funds, executed trades.
# Strictly Read-Only: Never calls order placement or mutation endpoints.
# Required: For syncing actual portfolio holdings and live valuation.
KITE_API_KEY=your_zerodha_kite_api_key
KITE_API_SECRET=your_zerodha_kite_api_secret
# Redirect URL configured in Kite Developer Console
KITE_REDIRECT_URL=http://127.0.0.1:8000/api/portfolio/kite/callback
# Daily generated access token (managed automatically via web callback)
KITE_ACCESS_TOKEN=

# ------------------------------------------------------------------------------
# 4. US MARKET DATA (ALPACA CANDIDATE)
# ------------------------------------------------------------------------------
# Where to obtain: Register at https://alpaca.markets/
# Purpose: US equities market data (IEX feed) for S&P 500 / MidCap 400.
# Required: Optional (US live signals remain disabled until configured)
ALPACA_API_KEY=your_alpaca_api_key
ALPACA_SECRET_KEY=your_alpaca_secret_key
ALPACA_ENDPOINT=https://paper-api.alpaca.markets

# ------------------------------------------------------------------------------
# 5. TELEGRAM NOTIFICATIONS
# ------------------------------------------------------------------------------
# Where to obtain: Create a bot with @BotFather on Telegram; get chat ID from @userinfobot
# Purpose: Evening Trade Plan summaries, BUY triggered alerts, trailing stop adjustments, news risks.
# Required: Optional (In-app SSE alerts function without Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ------------------------------------------------------------------------------
# 6. NEWS & REGULATORY DISCLOSURE SOURCES
# ------------------------------------------------------------------------------
# SEC EDGAR Submissions API (US corporate 8-K filings & earnings)
# SEC requires a user agent declaring user/organization and email address.
# Format: Sample Company Name AdminContact@<sample company domain>.com
# Required: Yes, for US corporate filings (free, no account or API key needed).
SEC_USER_AGENT="AlgoTrading Research research@example.com"

# Finnhub Stock API (US company news supplementary feed)
# Where to obtain: Free tier at https://finnhub.io/
# Purpose: Supplementary US company headlines (free tier 60 calls/min).
# Required: Optional. If unset, engine operates cleanly using GDELT + SEC EDGAR.
FINNHUB_API_KEY=


